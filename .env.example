# Copy to .env.local for local development. Never commit real values.
# Production and Preview values live in Vercel → Settings → Environment Variables.

# Contact form email delivery (resend.com → API Keys)
RESEND_API_KEY=

# Contact form rate limit (console.upstash.com → Redis database → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional sender. Defaults to Resend's sandbox sender, which can only
# deliver to the Resend account's own email address.
CONTACT_FROM_EMAIL=

# CI and E2E only: validate and rate-limit in memory, never send.
# Development without the keys above uses this mode automatically.
# CONTACT_DRY_RUN=1
