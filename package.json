    "@radix-ui/react-tabs": "^1.2.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-mdx-remote-client": "^2.1.12",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
